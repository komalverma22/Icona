/**
 * Builds the @icona/icons package from the icon library.
 *
 *   npm run build:icons
 *
 * Every component is produced by the same generator the details page uses
 * (components/export/code.ts), so the package, the website's copy buttons and
 * the shadcn registry can never disagree. Steps: generate TSX into
 * packages/icons/src/generated, write the two barrels, compile with tsc.
 */
import { execFileSync } from "node:child_process";
import { cpSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { generateCode } from "../components/export/code";
import { componentName, iconSlug } from "../components/export/naming";
import { DEFAULT_OPTIONS } from "../components/export/options";
import { iconVariants } from "../components/icons/iconLibrary";
import { isInteractive } from "../components/export/scene";
import { getMotions } from "../components/motion/registry";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const pkg = path.join(root, "packages", "icons");
const out = path.join(pkg, "src", "generated");

rmSync(out, { recursive: true, force: true });
rmSync(path.join(pkg, "dist"), { recursive: true, force: true });
mkdirSync(path.join(out, "icons"), { recursive: true });
mkdirSync(path.join(out, "animated"), { recursive: true });
// The particle runtime is shipped as-is, from the file the website's registry serves.
cpSync(path.join(root, "components", "motion", "particles.ts"), path.join(pkg, "src", "particles.ts"));

const shared = { types: "../../types.js", particles: "../../particles.js" };
const staticExports: string[] = [];
const animatedExports: string[] = [];
const seen = new Set<string>();

for (const variant of iconVariants) {
  const entries = [{ motion: undefined as undefined | ReturnType<typeof getMotions>[number], dir: "icons" }, ...getMotions(variant).filter((m) => !isInteractive(m)).map((motion) => ({ motion, dir: "animated" }))];
  for (const { motion, dir } of entries) {
    const slug = iconSlug(variant, motion);
    const name = componentName(variant, motion);
    if (seen.has(name)) throw new Error(`Duplicate component name ${name}`);
    seen.add(name);
    const code = generateCode(variant, { ...DEFAULT_OPTIONS, motionId: motion?.id ?? null }, "tsx", shared);
    writeFileSync(path.join(out, dir, `${slug}.tsx`), code.main.content);
    (dir === "icons" ? staticExports : animatedExports).push(`export { ${name} } from "./generated/${dir}/${slug}.js";`);
  }
}

const header = "// Generated by scripts/build-icons.mts - do not edit.\n";
writeFileSync(path.join(pkg, "src", "index.ts"), `${header}export type { IconProps } from "./types.js";\n${staticExports.join("\n")}\n`);
writeFileSync(path.join(pkg, "src", "animated.ts"), `${header}export type { AnimatedIconProps } from "./types.js";\n${animatedExports.join("\n")}\n`);

console.log(`Generated ${staticExports.length} static and ${animatedExports.length} animated components. Compiling…`);
execFileSync(process.execPath, [path.join(root, "node_modules", "typescript", "bin", "tsc"), "-p", pkg], { stdio: "inherit" });
// The package is ESM; README travels with it.
console.log(`Built ${JSON.parse(readFileSync(path.join(pkg, "package.json"), "utf8")).name} → packages/icons/dist`);
